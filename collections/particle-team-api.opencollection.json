{
  "opencollection": "1.0.0",
  "info": {
    "name": "Particle Cloud Authentication Team API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Team",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Read SCIM user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.particle.io/v1/orgs/:orgIdOrSlug/team/provision/Users/:user_id",
            "params": [
              {
                "name": "orgIdOrSlug",
                "value": "",
                "type": "path"
              },
              {
                "name": "user_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Read SCIM user"
        },
        {
          "info": {
            "name": "Modify SCIM user",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.particle.io/v1/orgs/:orgIdOrSlug/team/provision/Users/:user_id",
            "params": [
              {
                "name": "orgIdOrSlug",
                "value": "",
                "type": "path"
              },
              {
                "name": "user_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Modify SCIM user"
        }
      ]
    }
  ],
  "bundled": true
}