        {
          "id": "9f992bbd-0aa9-4fe3-ab57-ab67c68aa33e",
          "name": "Create a client",
          "request": {
            "name": "Create a client",
            "description": {
              "content": "Create an OAuth client that represents an app. Use type=installed for most web and mobile apps. If you want to have Particle users login to their account on Particle in order to give your app access to their devices, then you can go through the full OAuth authorization code grant flow using type=web. This is the same way you authorize it is similar to the way you give any app access to your Facebook or Twitter account. Your client secret will never be displayed again! Save it in a safe place. If you use type=web then you will also need to pass a redirect_uri parameter in the POST body. This is",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "clients"
              ],
              "host": [
                "{{baseUrl}}"
              ],
