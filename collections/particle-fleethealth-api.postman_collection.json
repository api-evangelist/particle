        {
          "id": "7bb85b06-b6f6-4e03-9ab7-a19225583eb9",
          "name": "Get online devices metrics",
          "request": {
            "name": "Get online devices metrics",
            "description": {
              "content": "Reports the number of devices online in this product. Each time bucket contains: count: the number of devices with an active cloud connection. Devices that recently went offline (due to being powered off or losing network connectivity) will be counted as online until the device misses sending a keep-alive message to the cloud. This is typically 25 seconds for Wi-Fi networks and 23 minutes for cellular networks. Can be filtered to include only devices with a certain firmware version, Device OS version or in a certain group.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "products",
                ":productIdOrSlug",
                "metrics",
                "online"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
