  "info": {
    "_postman_id": "bf3147a7-979a-4a7a-be00-a4c2c7d02f78",
    "name": "Particle Cloud Authentication Quarantine API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Particle Cloud REST API enables developers to interact with Particle-connected devices — calling device functions, reading variables, publishing and subscribing to events, managing SIM cards, performing OTA firmware updates, and administering product fleets. All requests use OAuth 2.0 bearer tokens and target https://api.particle.io.\n\nContact Support:\n Name: Particle Developer Support",
      "type": "text/plain"
    }
  }
