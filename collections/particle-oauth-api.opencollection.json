{
  "opencollection": "1.0.0",
  "info": {
    "name": "Particle Cloud Authentication OAuth API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "OAuth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List clients",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.particle.io/v1/clients"
          },
          "docs": "Get a list of all existing OAuth clients, either owned by the authenticated user or clients associated with a product."
        },
        {
          "info": {
            "name": "Create a client",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.particle.io/v1/clients"
          },
          "docs": "Create an OAuth client that represents an app. Use type=installed for most web and mobile apps. If you want to have Particle users login to their account on Particle in order to give your app access to their devices, then you can go through the full OAuth authorization code grant flow using type=web. This is the same way you authorize it is similar to the way you give any app access to your Facebook or Twitter account. Your client secret will never be displayed again! Save it in a safe place. If"
        },
        {
          "info": {
            "name": "Update a client",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.particle.io/v1/clients/:clientId",
            "params": [
              {
                "name": "clientId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Update the name or scope of an existing OAuth client."
        },
        {
          "info": {
            "name": "Delete a client",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.particle.io/v1/clients/:clientId",
            "params": [
              {
                "name": "clientId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Remove an OAuth client"
        }
      ]
    }
  ],
  "bundled": true
}