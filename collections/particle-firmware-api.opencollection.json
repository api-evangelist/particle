{
  "opencollection": "1.0.0",
  "info": {
    "name": "Particle Cloud Authentication Firmware API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Firmware",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Flash a device with a bundle",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.particle.io/v1/devices/:deviceId",
            "params": [
              {
                "name": "deviceId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Update the device firmware from a bundle"
        },
        {
          "info": {
            "name": "Compile source code",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.particle.io/v1/binaries"
          },
          "docs": "Compile source code into a binary for a device"
        },
        {
          "info": {
            "name": "List firmware build targets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.particle.io/v1/build_targets"
          },
          "docs": "Lists the firmware versions for all platforms that can be used as build targets during firmware compilation. Note: This endpoint does not require an access token."
        }
      ]
    }
  ],
  "bundled": true
}